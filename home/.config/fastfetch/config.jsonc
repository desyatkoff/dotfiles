{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch2",
        "color": {
            "1": "blue",
            "2": "blue"
        },
        "padding": {
            "left": 0,
            "right": 1
        }
    },
    "display": {
        "constants": [
            "\u001b[90G"
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "╭──────────────────────────────────────────────────╮"
        },
        {
            "type": "title",
            "format": "│ {#blue}{user-name}{#}@{#blue}{host-name}{$1}{#}│"
        },
        {
            "type": "custom",
            "format": "├──────────────────────────────────────────────────┤"
        },
        {
            "type": "os",
            "key": "{#}│ {#blue} OS",
            "format": "{pretty-name} {arch}{$1}│"
        },
        {
            "type": "kernel",
            "key": "{#}│ {#blue} Kernel",
            "format": "{release}{$1}│"
        },
        {
            "type": "uptime",
            "key": "{#}│ {#blue} Uptime",
            "format": "{formatted}{$1}│"
        },
        {
            "type": "packages",
            "key": "{#}│ {#blue}󰏖 Packages",
            "format": "{pacman} (pacman){$1}│"
        },
        {
            "type": "shell",
            "key": "{#}│ {#blue} Shell",
            "format": "{pretty-name} {version}{$1}│"
        },
        {
            "type": "display",
            "key": "{#}│ {#blue}󰍹 Resolution",
            "format": "{width}x{height}{$1}│"
        },
        {
            "type": "wm",
            "key": "{#}│ {#blue} WM",
            "format": "{pretty-name} {version} ({protocol-name}){$1}│"
        },
        {
            "type": "theme",
            "key": "{#}│ {#blue}󰉼 Theme",
            "format": "{theme1}{$1}│"
        },
        {
            "type": "icons",
            "key": "{#}│ {#blue} Icons",
            "format": "{icons1}{$1}│"
        },
        {
            "type": "terminal",
            "key": "{#}│ {#blue} Terminal",
            "format": "{pretty-name} {version}{$1}│"
        },
        {
            "type": "terminalfont",
            "key": "{#}│ {#blue} Terminal Font",
            "format": "{/name}{-}{/}{name}{?size} {size}{?}{$1}│"
        },
        {
            "type": "cpu",
            "key": "{#}│ {#blue} CPU",
            "format": "{name} ({cores-physical}) @ {7}{$1}│"
        },
        {
            "type": "gpu",
            "key": "{#}│ {#blue}󰾲 GPU",
            "format": "{name}{$1}│"
        },
        {
            "type": "memory",
            "key": "{#}│ {#blue} Memory",
            "format": "{used} / {total}{$1}│"
        },
        {
            "type": "swap",
            "key": "{#}│ {#blue}󰯍 Swap",
            "format": "{used} / {total}{$1}│"
        },
        {
            "type": "custom",
            "format": "╰──────────────────────────────────────────────────╯"
        },
        {
            "type": "custom",
            "format": "        {#light_black}󰊠    {#red}󰊠    {#green}󰊠    {#yellow}󰮯    {#blue}󰊠    {#magenta}󰊠    {#cyan}󰊠    {#white}󰊠        "
        }
    ]
}
